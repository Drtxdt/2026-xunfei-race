<?xml version="1.0"?>
<package format="2">
  <name>ucar_2026_competition</name>
  <version>0.1.0</version>
  <description>One-click orchestration for the 2026 U-CAR smart factory competition.</description>
  <maintainer email="ucar@todo.todo">ucar</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ucar_2026_competition_speech</depend>
  <depend>ucar_2026_smart_factory_llm</depend>

  <exec_depend>factory_sign_ppocr_rknn_test</exec_depend>
  <exec_depend>simple_navigator</exec_depend>
  <exec_depend>ucar_2026_track_end_stop</exec_depend>
  <exec_depend>ucar_2026_strict_mission</exec_depend>
  <exec_depend>ucar_2026_traffic_light_rknn_test</exec_depend>
  <exec_depend>ucar_nav</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>vision_triggered_navigator</exec_depend>
  <exec_depend>yolo</exec_depend>

  <export />
</package>
