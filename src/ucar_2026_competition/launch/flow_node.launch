<launch>
  <arg name="start_stage" default="full" />
  <arg name="debug" default="false" />
  <arg name="target_category" default="" />
  <arg name="target_item" default="" />
  <arg name="target_workshop" default="" />
  <arg name="sim_item" default="" />
  <arg name="sim_workshop" default="" />
  <arg name="sim_bridge_host" default="$(optenv SIM_BRIDGE_HOST)" />
  <arg name="sim_bridge_port" default="26003" />
  <arg name="traffic_pose_configured" default="false" />
  <arg name="traffic_x" default="0.0" />
  <arg name="traffic_y" default="0.0" />
  <arg name="traffic_yaw" default="0.0" />
  <arg name="traffic_decision" default="" />
  <arg name="navigator_publish_initial_pose" default="false" />
  <arg name="task2_center_only" default="false" />
  <arg name="max_coverage_anchors" default="0" />
  <arg name="target_center_steering_sign" default="-1.0" />
  <arg name="camera_boresight_yaw_offset" default="0.0" />
  <arg name="task2_vision_offset" default="0.4" />
  <arg name="coverage_scan_step_deg" default="20.0" />
  <arg name="coverage_scan_angular_speed" default="0.35" />
  <arg name="coverage_scan_dwell_sec" default="0.65" />
  <arg name="coverage_candidate_hold_sec" default="1.2" />
  <arg name="coverage_scan_max_dwell_sec" default="2.0" />
  <arg name="coverage_scan_pose_timeout_sec" default="0.5" />

  <node pkg="ucar_2026_competition" type="competition_flow.py"
        name="competition_flow" output="screen" required="true">
    <rosparam command="load" file="$(find ucar_2026_competition)/config/competition.yaml" />
    <param name="start_stage" value="$(arg start_stage)" />
    <param name="debug" value="$(arg debug)" />
    <param name="target_category" value="$(arg target_category)" />
    <param name="target_item" value="$(arg target_item)" />
    <param name="target_workshop" value="$(arg target_workshop)" />
    <param name="sim_item" value="$(arg sim_item)" />
    <param name="sim_workshop" value="$(arg sim_workshop)" />
    <param name="sim_bridge_host" value="$(arg sim_bridge_host)" />
    <param name="sim_bridge_port" value="$(arg sim_bridge_port)" />
    <param name="traffic_pose_configured" value="$(arg traffic_pose_configured)" />
    <param name="traffic_x" value="$(arg traffic_x)" />
    <param name="traffic_y" value="$(arg traffic_y)" />
    <param name="traffic_yaw" value="$(arg traffic_yaw)" />
    <param name="traffic_decision" value="$(arg traffic_decision)" />
    <param name="navigator_publish_initial_pose" value="$(arg navigator_publish_initial_pose)" />
    <param name="task2_center_only" value="$(arg task2_center_only)" />
    <param name="max_coverage_anchors" value="$(arg max_coverage_anchors)" />
    <param name="target_center_steering_sign" value="$(arg target_center_steering_sign)" />
    <param name="camera_boresight_yaw_offset" value="$(arg camera_boresight_yaw_offset)" />
    <param name="task2_vision_offset" value="$(arg task2_vision_offset)" />
    <param name="coverage_scan_step_deg" value="$(arg coverage_scan_step_deg)" />
    <param name="coverage_scan_angular_speed" value="$(arg coverage_scan_angular_speed)" />
    <param name="coverage_scan_dwell_sec" value="$(arg coverage_scan_dwell_sec)" />
    <param name="coverage_candidate_hold_sec" value="$(arg coverage_candidate_hold_sec)" />
    <param name="coverage_scan_max_dwell_sec" value="$(arg coverage_scan_max_dwell_sec)" />
    <param name="coverage_scan_pose_timeout_sec" value="$(arg coverage_scan_pose_timeout_sec)" />
  </node>
</launch>
