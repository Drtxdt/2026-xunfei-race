<launch>
  <arg name="start_stage" default="full" />
  <arg name="enable_simulation" default="false" />
  <arg name="debug" default="false" />
  <arg name="target_category" default="" />
  <arg name="target_item" default="" />
  <arg name="target_workshop" default="" />
  <arg name="sim_item" default="" />
  <arg name="sim_workshop" default="" />
  <arg name="sim_bridge_host" default="$(optenv SIM_BRIDGE_HOST)" />
  <arg name="sim_bridge_port" default="26003" />
  <arg name="traffic_pose_configured" default="false" />
  <arg name="traffic_x" default="0.0" />
  <arg name="traffic_y" default="0.0" />
  <arg name="traffic_yaw" default="0.0" />
  <arg name="traffic_decision" default="" />
  <arg name="skip_task4_stop_line_approach" default="false" />
  <arg name="navigator_publish_initial_pose" default="false" />
  <arg name="task2_center_only" default="false" />
  <arg name="max_coverage_anchors" default="0" />
  <arg name="target_center_steering_sign" default="-1.0" />
  <arg name="camera_boresight_yaw_offset" default="0.0" />
  <arg name="task2_vision_offset" default="0.4" />
  <arg name="coverage_scan_step_deg" default="20.0" />
  <arg name="coverage_scan_angular_speed" default="0.35" />
  <arg name="coverage_scan_dwell_sec" default="0.65" />
  <arg name="coverage_candidate_hold_sec" default="1.2" />
  <arg name="coverage_scan_max_dwell_sec" default="2.0" />
  <arg name="coverage_scan_pose_timeout_sec" default="0.5" />
  <arg name="coverage_goal_soft_timeout_sec" default="25.0" />
  <arg name="coverage_goal_hard_timeout_sec" default="40.0" />
  <arg name="coverage_goal_progress_window_sec" default="5.0" />
  <arg name="coverage_goal_min_progress" default="0.03" />
  <arg name="target_center_coarse_step_deg" default="4.0" />
  <arg name="target_center_fine_step_deg" default="2.0" />
  <arg name="target_center_start_speed" default="0.20" />
  <arg name="target_center_max_speed" default="0.35" />
  <arg name="target_center_timeout_sec" default="12.0" />
  <arg name="parking_box_width" default="0.50" />
  <arg name="parking_box_depth" default="0.50" />
  <arg name="parking_goal_offset" default="0.26" />
  <arg name="parking_staging_offset" default="0.55" />
  <arg name="parking_staging_timeout_sec" default="20.0" />
  <arg name="parking_staging_position_tolerance" default="0.10" />
  <arg name="parking_staging_yaw_tolerance" default="0.10" />
  <arg name="parking_docking_timeout_sec" default="15.0" />
  <arg name="parking_dock_max_x" default="0.10" />
  <arg name="parking_dock_max_y" default="0.06" />
  <arg name="parking_dock_max_yaw" default="0.15" />
  <arg name="parking_dock_min_yaw" default="0.15" />
  <arg name="parking_dock_normal_tolerance" default="0.015" />
  <arg name="parking_dock_tangent_tolerance" default="0.02" />
  <arg name="parking_dock_yaw_tolerance" default="0.035" />
  <arg name="parking_min_wall_distance" default="0.19" />
  <arg name="parking_lidar_stop_distance" default="0.15" />
  <arg name="parking_recenter_tolerance" default="0.04" />
  <arg name="parking_recenter_timeout_sec" default="8.0" />
  <arg name="parking_recenter_initial_wait_sec" default="1.0" />
  <arg name="parking_wall_fit_half_angle_deg" default="35.0" />
  <arg name="parking_wall_fit_min_points" default="12" />
  <arg name="parking_wall_fit_min_span" default="0.25" />
  <arg name="parking_wall_fit_near_min_span" default="0.18" />
  <arg name="parking_wall_fit_max_distance_jump" default="0.05" />
  <arg name="parking_wall_fit_max_normal_jump_deg" default="8.0" />
  <arg name="parking_wall_fit_max_residual" default="0.015" />
  <arg name="parking_wall_fit_max_normal_error_deg" default="20.0" />
  <arg name="parking_xy_tolerance" default="0.04" />
  <arg name="parking_yaw_tolerance" default="0.06" />
  <arg name="parking_normal_offset" default="0.0" />
  <arg name="parking_tangent_offset" default="0.0" />
  <arg name="trigger_ack_timeout_sec" default="2.0" />

  <node pkg="ucar_2026_competition" type="competition_flow.py"
        name="competition_flow" output="screen" required="true">
    <rosparam command="load" file="$(find ucar_2026_competition)/config/competition.yaml" />
    <param name="start_stage" value="$(arg start_stage)" />
    <param name="enable_simulation" value="$(arg enable_simulation)" />
    <param name="debug" value="$(arg debug)" />
    <param name="target_category" value="$(arg target_category)" />
    <param name="target_item" value="$(arg target_item)" />
    <param name="target_workshop" value="$(arg target_workshop)" />
    <param name="sim_item" value="$(arg sim_item)" />
    <param name="sim_workshop" value="$(arg sim_workshop)" />
    <param name="sim_bridge_host" value="$(arg sim_bridge_host)" />
    <param name="sim_bridge_port" value="$(arg sim_bridge_port)" />
    <param name="traffic_pose_configured" value="$(arg traffic_pose_configured)" />
    <param name="traffic_x" value="$(arg traffic_x)" />
    <param name="traffic_y" value="$(arg traffic_y)" />
    <param name="traffic_yaw" value="$(arg traffic_yaw)" />
    <param name="traffic_decision" value="$(arg traffic_decision)" />
    <param name="skip_task4_stop_line_approach" value="$(arg skip_task4_stop_line_approach)" />
    <param name="navigator_publish_initial_pose" value="$(arg navigator_publish_initial_pose)" />
    <param name="task2_center_only" value="$(arg task2_center_only)" />
    <param name="max_coverage_anchors" value="$(arg max_coverage_anchors)" />
    <param name="target_center_steering_sign" value="$(arg target_center_steering_sign)" />
    <param name="camera_boresight_yaw_offset" value="$(arg camera_boresight_yaw_offset)" />
    <param name="task2_vision_offset" value="$(arg task2_vision_offset)" />
    <param name="coverage_scan_step_deg" value="$(arg coverage_scan_step_deg)" />
    <param name="coverage_scan_angular_speed" value="$(arg coverage_scan_angular_speed)" />
    <param name="coverage_scan_dwell_sec" value="$(arg coverage_scan_dwell_sec)" />
    <param name="coverage_candidate_hold_sec" value="$(arg coverage_candidate_hold_sec)" />
    <param name="coverage_scan_max_dwell_sec" value="$(arg coverage_scan_max_dwell_sec)" />
    <param name="coverage_scan_pose_timeout_sec" value="$(arg coverage_scan_pose_timeout_sec)" />
    <param name="coverage_goal_soft_timeout_sec" value="$(arg coverage_goal_soft_timeout_sec)" />
    <param name="coverage_goal_hard_timeout_sec" value="$(arg coverage_goal_hard_timeout_sec)" />
    <param name="coverage_goal_progress_window_sec" value="$(arg coverage_goal_progress_window_sec)" />
    <param name="coverage_goal_min_progress" value="$(arg coverage_goal_min_progress)" />
    <param name="target_center_coarse_step_deg" value="$(arg target_center_coarse_step_deg)" />
    <param name="target_center_fine_step_deg" value="$(arg target_center_fine_step_deg)" />
    <param name="target_center_start_speed" value="$(arg target_center_start_speed)" />
    <param name="target_center_max_speed" value="$(arg target_center_max_speed)" />
    <param name="target_center_timeout_sec" value="$(arg target_center_timeout_sec)" />
    <param name="parking_box_width" value="$(arg parking_box_width)" />
    <param name="parking_box_depth" value="$(arg parking_box_depth)" />
    <param name="parking_goal_offset" value="$(arg parking_goal_offset)" />
    <param name="parking_staging_offset" value="$(arg parking_staging_offset)" />
    <param name="parking_staging_timeout_sec" value="$(arg parking_staging_timeout_sec)" />
    <param name="parking_staging_position_tolerance" value="$(arg parking_staging_position_tolerance)" />
    <param name="parking_staging_yaw_tolerance" value="$(arg parking_staging_yaw_tolerance)" />
    <param name="parking_docking_timeout_sec" value="$(arg parking_docking_timeout_sec)" />
    <param name="parking_dock_max_x" value="$(arg parking_dock_max_x)" />
    <param name="parking_dock_max_y" value="$(arg parking_dock_max_y)" />
    <param name="parking_dock_max_yaw" value="$(arg parking_dock_max_yaw)" />
    <param name="parking_dock_min_yaw" value="$(arg parking_dock_min_yaw)" />
    <param name="parking_dock_normal_tolerance" value="$(arg parking_dock_normal_tolerance)" />
    <param name="parking_dock_tangent_tolerance" value="$(arg parking_dock_tangent_tolerance)" />
    <param name="parking_dock_yaw_tolerance" value="$(arg parking_dock_yaw_tolerance)" />
    <param name="parking_min_wall_distance" value="$(arg parking_min_wall_distance)" />
    <param name="parking_lidar_stop_distance" value="$(arg parking_lidar_stop_distance)" />
    <param name="parking_recenter_tolerance" value="$(arg parking_recenter_tolerance)" />
    <param name="parking_recenter_timeout_sec" value="$(arg parking_recenter_timeout_sec)" />
    <param name="parking_recenter_initial_wait_sec" value="$(arg parking_recenter_initial_wait_sec)" />
    <param name="parking_wall_fit_half_angle_deg" value="$(arg parking_wall_fit_half_angle_deg)" />
    <param name="parking_wall_fit_min_points" value="$(arg parking_wall_fit_min_points)" />
    <param name="parking_wall_fit_min_span" value="$(arg parking_wall_fit_min_span)" />
    <param name="parking_wall_fit_near_min_span" value="$(arg parking_wall_fit_near_min_span)" />
    <param name="parking_wall_fit_max_distance_jump" value="$(arg parking_wall_fit_max_distance_jump)" />
    <param name="parking_wall_fit_max_normal_jump_deg" value="$(arg parking_wall_fit_max_normal_jump_deg)" />
    <param name="parking_wall_fit_max_residual" value="$(arg parking_wall_fit_max_residual)" />
    <param name="parking_wall_fit_max_normal_error_deg" value="$(arg parking_wall_fit_max_normal_error_deg)" />
    <param name="parking_xy_tolerance" value="$(arg parking_xy_tolerance)" />
    <param name="parking_yaw_tolerance" value="$(arg parking_yaw_tolerance)" />
    <param name="parking_normal_offset" value="$(arg parking_normal_offset)" />
    <param name="parking_tangent_offset" value="$(arg parking_tangent_offset)" />
    <param name="trigger_ack_timeout_sec" value="$(arg trigger_ack_timeout_sec)" />
  </node>
</launch>
