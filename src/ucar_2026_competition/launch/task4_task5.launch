<launch>
  <arg name="debug" default="false" />
  <arg name="start_external_voice" default="true" />

  <!--
    The vehicle must already be stopped before the task4 stop line, facing the
    traffic light. This launch intentionally skips navigation and visual
    stop-line approach, then keeps one controller alive through task4/task5.
  -->
  <include file="$(find ucar_2026_competition)/launch/common_core.launch">
    <arg name="start_nav" value="true" />
    <arg name="start_camera" value="true" />
    <arg name="start_speech" value="true" />
    <arg name="start_tts" value="$(arg start_external_voice)" />
    <arg name="start_rviz" value="$(arg debug)" />
  </include>

  <include file="$(find ucar_2026_competition)/launch/flow_node.launch">
    <arg name="start_stage" value="task4_task5" />
    <arg name="debug" value="$(arg debug)" />
    <arg name="skip_task4_stop_line_approach" value="true" />
    <arg name="navigator_publish_initial_pose" value="false" />
  </include>
</launch>
