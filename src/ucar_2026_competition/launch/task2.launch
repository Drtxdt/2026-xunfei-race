<launch>
  <arg name="debug" default="false" />
  <arg name="start_external_voice" default="true" />
  <arg name="target_category" default="" />
  <arg name="target_item" default="" />
  <arg name="target_workshop" default="" />
  <arg name="navigator_publish_initial_pose" default="true" />
  <arg name="center_only" default="false" />
  <arg name="max_coverage_anchors" default="0" />
  <arg name="target_center_steering_sign" default="-1.0" />
  <arg name="camera_boresight_yaw_offset" default="0.0" />
  <arg name="vision_offset" default="0.4" />
  <arg name="coverage_scan_step_deg" default="20.0" />
  <arg name="coverage_scan_angular_speed" default="0.35" />
  <arg name="coverage_scan_dwell_sec" default="0.65" />
  <arg name="coverage_candidate_hold_sec" default="1.2" />
  <arg name="coverage_scan_max_dwell_sec" default="2.0" />
  <arg name="coverage_scan_pose_timeout_sec" default="0.5" />
  <arg name="target_center_coarse_step_deg" default="4.0" />
  <arg name="target_center_fine_step_deg" default="2.0" />
  <arg name="target_center_start_speed" default="0.20" />
  <arg name="target_center_max_speed" default="0.35" />
  <arg name="target_center_timeout_sec" default="12.0" />
  <arg name="parking_box_width" default="0.50" />
  <arg name="parking_box_depth" default="0.50" />
  <arg name="parking_goal_offset" default="0.25" />
  <arg name="parking_xy_tolerance" default="0.04" />
  <arg name="parking_yaw_tolerance" default="0.06" />
  <include file="$(find ucar_2026_competition)/launch/common_core.launch">
    <arg name="start_nav" value="true" />
    <arg name="start_camera" value="true" />
    <arg name="start_speech" value="true" />
    <arg name="start_tts" value="$(arg start_external_voice)" />
    <arg name="start_rviz" value="$(arg debug)" />
  </include>
  <include file="$(find ucar_2026_competition)/launch/flow_node.launch">
    <arg name="start_stage" value="task2" />
    <arg name="debug" value="$(arg debug)" />
    <arg name="target_category" value="$(arg target_category)" />
    <arg name="target_item" value="$(arg target_item)" />
    <arg name="target_workshop" value="$(arg target_workshop)" />
    <arg name="navigator_publish_initial_pose" value="$(arg navigator_publish_initial_pose)" />
    <arg name="task2_center_only" value="$(arg center_only)" />
    <arg name="max_coverage_anchors" value="$(arg max_coverage_anchors)" />
    <arg name="target_center_steering_sign" value="$(arg target_center_steering_sign)" />
    <arg name="camera_boresight_yaw_offset" value="$(arg camera_boresight_yaw_offset)" />
    <arg name="task2_vision_offset" value="$(arg vision_offset)" />
    <arg name="coverage_scan_step_deg" value="$(arg coverage_scan_step_deg)" />
    <arg name="coverage_scan_angular_speed" value="$(arg coverage_scan_angular_speed)" />
    <arg name="coverage_scan_dwell_sec" value="$(arg coverage_scan_dwell_sec)" />
    <arg name="coverage_candidate_hold_sec" value="$(arg coverage_candidate_hold_sec)" />
    <arg name="coverage_scan_max_dwell_sec" value="$(arg coverage_scan_max_dwell_sec)" />
    <arg name="coverage_scan_pose_timeout_sec" value="$(arg coverage_scan_pose_timeout_sec)" />
    <arg name="target_center_coarse_step_deg" value="$(arg target_center_coarse_step_deg)" />
    <arg name="target_center_fine_step_deg" value="$(arg target_center_fine_step_deg)" />
    <arg name="target_center_start_speed" value="$(arg target_center_start_speed)" />
    <arg name="target_center_max_speed" value="$(arg target_center_max_speed)" />
    <arg name="target_center_timeout_sec" value="$(arg target_center_timeout_sec)" />
    <arg name="parking_box_width" value="$(arg parking_box_width)" />
    <arg name="parking_box_depth" value="$(arg parking_box_depth)" />
    <arg name="parking_goal_offset" value="$(arg parking_goal_offset)" />
    <arg name="parking_xy_tolerance" value="$(arg parking_xy_tolerance)" />
    <arg name="parking_yaw_tolerance" value="$(arg parking_yaw_tolerance)" />
  </include>
</launch>
