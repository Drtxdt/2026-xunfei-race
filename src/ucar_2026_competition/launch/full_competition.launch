<launch>
  <!-- Ubuntu-only official entrypoint. Physical nodes are launched over SSH. -->
  <arg name="debug" default="false" />
  <arg name="start_external_voice" default="true" />
  <arg name="enable_simulation" default="true" />
  <arg name="start_local_sim" default="true" />
  <arg name="competition_workspace" default="$(optenv UCAR_COMPETITION_WS)" />
  <arg name="sim_workspace" default="$(optenv UCAR_SIM_WS)" />
  <arg name="robot_ssh_target" default="$(optenv UCAR_ROBOT_HOST)" />
  <arg name="robot_workspace" default="$(optenv UCAR_ROBOT_WS /home/ucar/2026-xunfei-race)" />
  <arg name="robot_environment_file" default="$(optenv UCAR_ROBOT_ENV /home/ucar/.config/ucar_2026/robot_env.sh)" />
  <arg name="ssh_connect_timeout_sec" default="8" />
  <arg name="robot_startup_timeout_sec" default="30" />
  <arg name="sim_bridge_host" default="" />
  <arg name="sim_bridge_port" default="26003" />
  <arg name="sim_gui" default="true" />
  <arg name="sim_startup_timeout_sec" default="120" />
  <arg name="sim_connect_timeout_sec" default="120" />
  <arg name="traffic_pose_configured" default="true" />
  <arg name="traffic_x" default="0.2395" />
  <arg name="traffic_y" default="-3.10" />
  <arg name="traffic_yaw" default="-1.5596" />
  <arg name="parking_normal_offset" default="0.0" />
  <arg name="parking_tangent_offset" default="0.0" />
  <arg name="parking_goal_offset" default="0.26" />
  <arg name="parking_staging_offset" default="0.55" />
  <arg name="parking_staging_timeout_sec" default="20.0" />
  <arg name="parking_staging_position_tolerance" default="0.16" />
  <arg name="parking_staging_yaw_tolerance" default="0.10" />
  <arg name="parking_docking_timeout_sec" default="30.0" />
  <arg name="parking_dock_max_x" default="0.10" />
  <arg name="parking_dock_max_y" default="0.06" />
  <arg name="parking_dock_max_yaw" default="0.30" />
  <arg name="parking_dock_min_yaw" default="0.30" />
  <arg name="parking_dock_normal_tolerance" default="0.02" />
  <arg name="parking_dock_tangent_tolerance" default="0.02" />
  <arg name="parking_dock_yaw_tolerance" default="0.05" />
  <arg name="parking_min_wall_distance" default="0.19" />
  <arg name="parking_lidar_stop_distance" default="0.15" />
  <arg name="parking_recenter_tolerance" default="0.08" />
  <arg name="parking_recenter_timeout_sec" default="8.0" />
  <arg name="parking_recenter_initial_wait_sec" default="1.0" />
  <arg name="coverage_goal_soft_timeout_sec" default="25.0" />
  <arg name="coverage_goal_hard_timeout_sec" default="40.0" />
  <arg name="coverage_goal_progress_window_sec" default="5.0" />
  <arg name="coverage_goal_min_progress" default="0.03" />
  <arg name="coverage_anchor_observation_radius" default="0.45" />
  <arg name="coverage_near_anchor_stall_timeout_sec" default="3.0" />
  <arg name="coverage_rotation_min_clearance" default="0.28" />
  <arg name="parking_wall_fit_half_angle_deg" default="35.0" />
  <arg name="parking_wall_fit_min_points" default="12" />
  <arg name="parking_wall_fit_min_span" default="0.25" />
  <arg name="parking_wall_fit_near_min_span" default="0.18" />
  <arg name="parking_wall_fit_max_distance_jump" default="0.05" />
  <arg name="parking_wall_fit_max_normal_jump_deg" default="8.0" />
  <arg name="parking_wall_fit_max_residual" default="0.015" />
  <arg name="parking_wall_fit_max_normal_error_deg" default="20.0" />
  <arg name="trigger_ack_timeout_sec" default="2.0" />

  <group if="$(eval enable_simulation and start_local_sim)">
    <include file="$(find ucar_2026_competition)/launch/local_sim.launch">
      <arg name="sim_workspace" value="$(arg sim_workspace)" />
      <arg name="robot_ssh_target" value="$(arg robot_ssh_target)" />
      <arg name="sim_bridge_port" value="$(arg sim_bridge_port)" />
      <arg name="sim_gui" value="$(arg sim_gui)" />
      <arg name="sim_startup_timeout_sec" value="$(arg sim_startup_timeout_sec)" />
    </include>
  </group>

  <node pkg="ucar_2026_competition"
        type="robot_supervisor.py"
        name="robot_supervisor"
        output="screen"
        required="true">
    <param name="robot_ssh_target" value="$(arg robot_ssh_target)" />
    <param name="competition_workspace" value="$(arg competition_workspace)" />
    <param name="robot_workspace" value="$(arg robot_workspace)" />
    <param name="robot_environment_file" value="$(arg robot_environment_file)" />
    <param name="ssh_connect_timeout_sec" value="$(arg ssh_connect_timeout_sec)" />
    <param name="robot_startup_timeout_sec" value="$(arg robot_startup_timeout_sec)" />
    <rosparam param="physical_launch_arguments" subst_value="true">
      debug: "$(arg debug)"
      start_external_voice: "$(arg start_external_voice)"
      enable_simulation: "$(arg enable_simulation)"
      use_external_sim_bridge: "$(eval enable_simulation and not start_local_sim)"
      sim_bridge_host: "$(arg sim_bridge_host)"
      sim_bridge_port: "$(arg sim_bridge_port)"
      sim_connect_timeout_sec: "$(arg sim_connect_timeout_sec)"
      traffic_pose_configured: "$(arg traffic_pose_configured)"
      traffic_x: "$(arg traffic_x)"
      traffic_y: "$(arg traffic_y)"
      traffic_yaw: "$(arg traffic_yaw)"
      parking_normal_offset: "$(arg parking_normal_offset)"
      parking_tangent_offset: "$(arg parking_tangent_offset)"
      parking_goal_offset: "$(arg parking_goal_offset)"
      parking_staging_offset: "$(arg parking_staging_offset)"
      parking_staging_timeout_sec: "$(arg parking_staging_timeout_sec)"
      parking_staging_position_tolerance: "$(arg parking_staging_position_tolerance)"
      parking_staging_yaw_tolerance: "$(arg parking_staging_yaw_tolerance)"
      parking_docking_timeout_sec: "$(arg parking_docking_timeout_sec)"
      parking_dock_max_x: "$(arg parking_dock_max_x)"
      parking_dock_max_y: "$(arg parking_dock_max_y)"
      parking_dock_max_yaw: "$(arg parking_dock_max_yaw)"
      parking_dock_min_yaw: "$(arg parking_dock_min_yaw)"
      parking_dock_normal_tolerance: "$(arg parking_dock_normal_tolerance)"
      parking_dock_tangent_tolerance: "$(arg parking_dock_tangent_tolerance)"
      parking_dock_yaw_tolerance: "$(arg parking_dock_yaw_tolerance)"
      parking_min_wall_distance: "$(arg parking_min_wall_distance)"
      parking_lidar_stop_distance: "$(arg parking_lidar_stop_distance)"
      parking_recenter_tolerance: "$(arg parking_recenter_tolerance)"
      parking_recenter_timeout_sec: "$(arg parking_recenter_timeout_sec)"
      parking_recenter_initial_wait_sec: "$(arg parking_recenter_initial_wait_sec)"
      coverage_goal_soft_timeout_sec: "$(arg coverage_goal_soft_timeout_sec)"
      coverage_goal_hard_timeout_sec: "$(arg coverage_goal_hard_timeout_sec)"
      coverage_goal_progress_window_sec: "$(arg coverage_goal_progress_window_sec)"
      coverage_goal_min_progress: "$(arg coverage_goal_min_progress)"
      coverage_anchor_observation_radius: "$(arg coverage_anchor_observation_radius)"
      coverage_near_anchor_stall_timeout_sec: "$(arg coverage_near_anchor_stall_timeout_sec)"
      coverage_rotation_min_clearance: "$(arg coverage_rotation_min_clearance)"
      parking_wall_fit_half_angle_deg: "$(arg parking_wall_fit_half_angle_deg)"
      parking_wall_fit_min_points: "$(arg parking_wall_fit_min_points)"
      parking_wall_fit_min_span: "$(arg parking_wall_fit_min_span)"
      parking_wall_fit_near_min_span: "$(arg parking_wall_fit_near_min_span)"
      parking_wall_fit_max_distance_jump: "$(arg parking_wall_fit_max_distance_jump)"
      parking_wall_fit_max_normal_jump_deg: "$(arg parking_wall_fit_max_normal_jump_deg)"
      parking_wall_fit_max_residual: "$(arg parking_wall_fit_max_residual)"
      parking_wall_fit_max_normal_error_deg: "$(arg parking_wall_fit_max_normal_error_deg)"
      trigger_ack_timeout_sec: "$(arg trigger_ack_timeout_sec)"
    </rosparam>
  </node>
</launch>
