<launch>
  <arg name="start_driver" default="true" />
  <arg name="start_camera" default="true" />
  <arg name="start_viewer" default="true" />
  <arg name="config_file" default="$(find ucar_2026_track_end_stop)/config/track_end_stop.yaml" />

  <group if="$(arg start_driver)">
    <include file="$(find ucar_controller)/launch/base_driver.launch" />
  </group>

  <group if="$(arg start_camera)">
    <include file="$(find usb_cam)/launch/usb_cam-test.launch" />
  </group>

  <node pkg="ucar_2026_track_end_stop" type="track_end_stop_node" name="track_end_stop_node" output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>

  <!-- Debug relay: converts raw debug image to compressed JPEG for MobaXterm -->
  <node pkg="ucar_2026_line_follow" type="right_debug_relay_node.py" name="track_end_stop_debug_relay" output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="debug_image_topic" value="/track_end_stop/debug_image" />
    <param name="raw_image_topic" value="/usb_cam/image_raw" />
    <param name="compressed_debug_topic" value="/track_end_stop/debug_image/compressed" />
    <param name="compressed_raw_topic" value="/track_end_stop/raw_image/compressed" />
    <param name="debug_relay_status_topic" value="/track_end_stop/debug_relay/status" />
    <param name="jpeg_quality" value="75" />
    <param name="debug_max_publish_fps" value="12.0" />
    <param name="publish_raw_compressed" value="true" />
  </node>

  <!-- X11 image_view for local MobaXterm display. Disable if not using X11. -->
  <group if="$(arg start_viewer)">
    <node pkg="image_view" type="image_view" name="track_end_stop_viewer" output="screen">
      <remap from="image" to="/track_end_stop/debug_image" />
      <param name="image_transport" value="raw" />
    </node>
  </group>
</launch>
