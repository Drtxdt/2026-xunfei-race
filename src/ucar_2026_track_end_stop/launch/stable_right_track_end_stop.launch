<launch>
  <arg name="start_driver" default="true" />
  <arg name="start_camera" default="true" />
  <arg name="start_viewer" default="true" />
  <arg name="config_file" default="$(find ucar_2026_track_end_stop)/config/right_track_end_stop.yaml" />

  <group if="$(arg start_driver)">
    <include file="$(find ucar_controller)/launch/base_driver.launch" />
  </group>

  <group if="$(arg start_camera)">
    <include file="$(find usb_cam)/launch/usb_cam-test.launch" />
  </group>

  <node pkg="ucar_2026_track_end_stop" type="stable_right_track_end_stop_node" name="stable_right_track_end_stop_node" output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="status_topic" value="/stable_right_track_end_stop/status" />
    <param name="debug_image_topic" value="/stable_right_track_end_stop/debug_image" />
    <param name="debug_info_topic" value="/stable_right_track_end_stop/debug_info" />
    <param name="target_right_x" value="200" />
    <param name="base_speed" value="0.32" />
    <param name="curve_speed" value="0.28" />
    <param name="search_speed" value="0.10" />
    <param name="search_angular_speed" value="-0.26" />
    <param name="lost_linear_speed" value="0.14" />
    <param name="lost_angular_speed" value="-0.22" />
    <param name="kp" value="0.0052" />
    <param name="kd" value="0.0018" />
    <param name="error_alpha" value="0.22" />
    <param name="curve_error_threshold" value="38.0" />
    <param name="curve_angular_gain" value="1.18" />
    <param name="max_angular_speed" value="0.55" />
    <param name="roi_y_start_ratio" value="0.60" />
    <param name="white_s_max" value="45" />
    <param name="white_v_min" value="200" />
    <param name="min_component_area" value="260" />
  </node>

  <node pkg="ucar_2026_line_follow" type="right_debug_relay_node.py" name="stable_right_track_end_stop_debug_relay" output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="debug_image_topic" value="/stable_right_track_end_stop/debug_image" />
    <param name="raw_image_topic" value="/usb_cam/image_raw" />
    <param name="compressed_debug_topic" value="/stable_right_track_end_stop/debug_image/compressed" />
    <param name="compressed_raw_topic" value="/stable_right_track_end_stop/raw_image/compressed" />
    <param name="debug_relay_status_topic" value="/stable_right_track_end_stop/debug_relay/status" />
    <param name="jpeg_quality" value="75" />
    <param name="debug_max_publish_fps" value="12.0" />
    <param name="publish_raw_compressed" value="true" />
  </node>

  <group if="$(arg start_viewer)">
    <node pkg="image_view" type="image_view" name="stable_right_track_end_stop_viewer" output="screen">
      <remap from="image" to="/stable_right_track_end_stop/debug_image" />
      <param name="image_transport" value="raw" />
    </node>
  </group>
</launch>
