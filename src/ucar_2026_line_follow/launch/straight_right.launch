<launch>

  <!-- ================================= -->
  <!-- 参数 -->
  <!-- ================================= -->

  <arg name="start_driver" default="true" />
  <arg name="start_camera" default="true" />

  <arg name="config_file"
       default="$(find ucar_2026_line_follow)/config/straight_right.yaml" />

  <!-- ================================= -->
  <!-- 启动底盘 -->
  <!-- ================================= -->

  <group if="$(arg start_driver)">

    <include file="$(find ucar_controller)/launch/base_driver.launch" />

  </group>

  <!-- ================================= -->
  <!-- 启动摄像头 -->
  <!-- ================================= -->

  <group if="$(arg start_camera)">

    <include file="$(find usb_cam)/launch/usb_cam-test.launch" />

  </group>

  <!-- ================================= -->
  <!-- 巡线节点 -->
  <!-- ================================= -->

  <node pkg="ucar_2026_line_follow"
        type="stable_right_follow.py"
        name="stable_right_follow"
        output="screen"
        required="true">

    <rosparam command="load"
              file="$(arg config_file)" />

    <param name="image_topic"
           value="/usb_cam/image_raw" />

    <param name="cmd_vel_topic"
           value="/cmd_vel" />

    <param name="start_topic"
           value="/line_follow/start" />

    <param name="status_topic"
           value="/line_follow/status" />

  </node>

  <!-- ================================= -->
  <!-- 调试节点 -->
  <!-- ================================= -->

  <node pkg="ucar_2026_line_follow"
        type="right_debug_relay_node.py"
        name="right_debug_relay_node"
        output="screen">

    <rosparam command="load"
              file="$(arg config_file)" />

  </node>

</launch>