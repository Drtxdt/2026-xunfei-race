<launch>
  <arg name="start_driver" default="true" />
  <arg name="start_camera" default="true" />
  <arg name="config_file" default="$(find ucar_2026_line_follow)/config/straight_right.yaml" />

  <group if="$(arg start_driver)">
    <include file="$(find ucar_controller)/launch/base_driver.launch" />
  </group>

  <group if="$(arg start_camera)">
    <include file="$(find usb_cam)/launch/usb_cam-test.launch" />
  </group>

  <node name="line_follow_straight_right" pkg="ucar_2026_line_follow" type="line_follow_straight_right.py" output="screen">
    <rosparam file="$(arg config_file)" command="load"/>
    <param name="image_topic" value="/usb_cam/image_raw"/>
  </node>
</launch>
