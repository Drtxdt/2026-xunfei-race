<!-- straight_right.launch -->

<launch>

    <!-- 底盘 -->
    <node pkg="base_driver"
          type="base_driver"
          name="base_driver"
          output="screen" />

    <!-- 摄像头 -->
    <node pkg="usb_cam"
          type="usb_cam_node"
          name="usb_cam"
          output="screen">

        <param name="video_device" value="/dev/video0" />

        <param name="image_width" value="640" />
        <param name="image_height" value="480" />

        <!-- MJPEG更稳定 -->
        <param name="pixel_format" value="mjpeg" />

        <!-- 提高帧率 -->
        <param name="framerate" value="30" />

        <!-- 降低曝光波动 -->
        <param name="io_method" value="mmap" />

    </node>

    <!-- 巡线节点 -->
    <node pkg="ucar_2026_line_follow"
          type="stable_right_follow.py"
          name="stable_right_follow"
          output="screen">

        <rosparam command="load"
                  file="$(find ucar_2026_line_follow)/config/straight_right.yaml" />

    </node>

</launch>