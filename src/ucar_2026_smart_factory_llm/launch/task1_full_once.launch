<launch>
  <arg name="voice_instruction" />
  <arg name="wait_for_wakeup" default="true" />
  <arg name="navigate_to_qr" default="true" />
  <arg name="wakeup_topic" default="/wakeup" />
  <arg name="qr_topic" default="/qr_code_data" />
  <arg name="service_name" default="/smart_factory_llm/reason_pickup_order" />
  <arg name="speak_topic" default="/speak" />
  <arg name="announce_service" default="/competition_speech/announce" />
  <arg name="expected_count" default="3" />
  <arg name="timeout_sec" default="45.0" />
  <arg name="move_base_timeout_sec" default="60.0" />

  <!-- QR area pose copied from the original car state machine. Tune with nav teammates if needed. -->
  <arg name="goal_frame" default="map" />
  <arg name="qr_x" default="1.00" />
  <arg name="qr_y" default="0.51" />
  <arg name="qr_z" default="0.0" />
  <arg name="qr_qx" default="0.0" />
  <arg name="qr_qy" default="0.0" />
  <arg name="qr_qz" default="1.0" />
  <arg name="qr_qw" default="0.0" />

  <node pkg="ucar_2026_smart_factory_llm" type="task1_full_once.py" name="task1_full_once" output="screen">
    <param name="voice_instruction" value="$(arg voice_instruction)" />
    <param name="wait_for_wakeup" value="$(arg wait_for_wakeup)" />
    <param name="navigate_to_qr" value="$(arg navigate_to_qr)" />
    <param name="wakeup_topic" value="$(arg wakeup_topic)" />
    <param name="qr_topic" value="$(arg qr_topic)" />
    <param name="service_name" value="$(arg service_name)" />
    <param name="speak_topic" value="$(arg speak_topic)" />
    <param name="announce_service" value="$(arg announce_service)" />
    <param name="expected_count" value="$(arg expected_count)" />
    <param name="timeout_sec" value="$(arg timeout_sec)" />
    <param name="move_base_timeout_sec" value="$(arg move_base_timeout_sec)" />
    <param name="goal_frame" value="$(arg goal_frame)" />
    <param name="qr_x" value="$(arg qr_x)" />
    <param name="qr_y" value="$(arg qr_y)" />
    <param name="qr_z" value="$(arg qr_z)" />
    <param name="qr_qx" value="$(arg qr_qx)" />
    <param name="qr_qy" value="$(arg qr_qy)" />
    <param name="qr_qz" value="$(arg qr_qz)" />
    <param name="qr_qw" value="$(arg qr_qw)" />
  </node>
</launch>
