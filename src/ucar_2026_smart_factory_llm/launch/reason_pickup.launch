<launch>
  <arg name="config_file" default="$(find ucar_2026_smart_factory_llm)/config/llm_defaults.yaml" />
  <rosparam command="load" file="$(arg config_file)" />

  <!-- Read XF_SPARK_API_PASSWORD inside the process. Never copy it to the ROS
       parameter server, where roslaunch would print it in startup logs. -->
  <node pkg="ucar_2026_smart_factory_llm" type="reason_pickup_server.py"
        name="smart_factory_llm" output="screen" />
</launch>
