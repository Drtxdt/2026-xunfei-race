<launch>
  <!-- vision_triggered_navigator 启动文件 -->

  <arg name="trigger_mode" default="keyboard" />
  <arg name="vision_topic" default="/vision/detected" />
  <arg name="status_topic" default="/vision_triggered_navigator/status" />
  <arg name="trigger_service" default="/vision_triggered_navigator/trigger_target" />
  <arg name="publish_initial_pose" default="true" />
  <arg name="navigate_to_end_after_trigger" default="true" />
  <arg name="coverage_search_mode" default="false" />
  <arg name="target_topic" default="/vision/target" />
  <arg name="target_center_steering_sign" default="-1.0" />
  <arg name="camera_boresight_yaw_offset" default="0.0" />
  <arg name="center_only" default="false" />
  <arg name="max_coverage_anchors" default="0" />
  <arg name="vision_offset" default="0.4" />
  <arg name="coverage_scan_step_deg" default="20.0" />
  <arg name="coverage_scan_angular_speed" default="0.35" />
  <arg name="coverage_scan_dwell_sec" default="0.65" />
  <arg name="coverage_candidate_hold_sec" default="1.2" />
  <arg name="coverage_scan_max_dwell_sec" default="2.0" />
  <arg name="coverage_scan_pose_timeout_sec" default="0.5" />
  <arg name="target_center_coarse_step_deg" default="4.0" />
  <arg name="target_center_fine_step_deg" default="2.0" />
  <arg name="target_center_start_speed" default="0.20" />
  <arg name="target_center_step_max_speed" default="0.35" />
  <arg name="target_center_timeout_sec" default="12.0" />
  <arg name="validate_parking_box" default="false" />
  <arg name="parking_box_width" default="0.50" />
  <arg name="parking_box_depth" default="0.50" />
  <arg name="parking_goal_offset" default="0.4" />
  <arg name="parking_normal_offset" default="0.0" />
  <arg name="parking_tangent_offset" default="0.0" />
  <arg name="parking_xy_tolerance" default="0.04" />
  <arg name="parking_yaw_tolerance" default="0.06" />

  <!-- 加载参数 -->
  <rosparam file="$(find vision_triggered_navigator)/config/vision_triggered_navigator.yaml" command="load" ns="vision_triggered_navigator" />

  <!-- 启动导航节点 -->
  <node pkg="vision_triggered_navigator" type="vision_triggered_navigator.py" name="vision_triggered_navigator" output="screen">
    <!-- 示例：命令行覆盖触发模式或目标点
         roslaunch vision_triggered_navigator vision_triggered_navigator.launch trigger_mode:=vision
    -->
    <param name="trigger_mode" value="$(arg trigger_mode)" />
    <param name="vision_topic" value="$(arg vision_topic)" />
    <param name="status_topic" value="$(arg status_topic)" />
    <param name="trigger_service" value="$(arg trigger_service)" />
    <param name="publish_initial_pose" value="$(arg publish_initial_pose)" />
    <param name="navigate_to_end_after_trigger" value="$(arg navigate_to_end_after_trigger)" />
    <param name="coverage_search_mode" value="$(arg coverage_search_mode)" />
    <param name="target_topic" value="$(arg target_topic)" />
    <param name="target_center_steering_sign" value="$(arg target_center_steering_sign)" />
    <param name="camera_boresight_yaw_offset" value="$(arg camera_boresight_yaw_offset)" />
    <param name="center_only" value="$(arg center_only)" />
    <param name="max_coverage_anchors" value="$(arg max_coverage_anchors)" />
    <param name="vision_offset" value="$(arg vision_offset)" />
    <param name="coverage_scan_step_deg" value="$(arg coverage_scan_step_deg)" />
    <param name="coverage_scan_angular_speed" value="$(arg coverage_scan_angular_speed)" />
    <param name="coverage_scan_dwell_sec" value="$(arg coverage_scan_dwell_sec)" />
    <param name="coverage_candidate_hold_sec" value="$(arg coverage_candidate_hold_sec)" />
    <param name="coverage_scan_max_dwell_sec" value="$(arg coverage_scan_max_dwell_sec)" />
    <param name="coverage_scan_pose_timeout_sec" value="$(arg coverage_scan_pose_timeout_sec)" />
    <param name="target_center_coarse_step_deg" value="$(arg target_center_coarse_step_deg)" />
    <param name="target_center_fine_step_deg" value="$(arg target_center_fine_step_deg)" />
    <param name="target_center_start_speed" value="$(arg target_center_start_speed)" />
    <param name="target_center_step_max_speed" value="$(arg target_center_step_max_speed)" />
    <param name="target_center_timeout_sec" value="$(arg target_center_timeout_sec)" />
    <param name="validate_parking_box" value="$(arg validate_parking_box)" />
    <param name="parking_box_width" value="$(arg parking_box_width)" />
    <param name="parking_box_depth" value="$(arg parking_box_depth)" />
    <param name="parking_goal_offset" value="$(arg parking_goal_offset)" />
    <param name="parking_normal_offset" value="$(arg parking_normal_offset)" />
    <param name="parking_tangent_offset" value="$(arg parking_tangent_offset)" />
    <param name="parking_xy_tolerance" value="$(arg parking_xy_tolerance)" />
    <param name="parking_yaw_tolerance" value="$(arg parking_yaw_tolerance)" />
  </node>

</launch>
