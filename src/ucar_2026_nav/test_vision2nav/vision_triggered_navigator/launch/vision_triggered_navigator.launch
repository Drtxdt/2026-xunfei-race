<launch>
  <!-- vision_triggered_navigator 启动文件 -->

  <arg name="trigger_mode" default="keyboard" />
  <arg name="vision_topic" default="/vision/detected" />
  <arg name="status_topic" default="/vision_triggered_navigator/status" />
  <arg name="trigger_service" default="/vision_triggered_navigator/trigger_target" />
  <arg name="start_paused" default="false" />
  <arg name="start_navigation_service" default="/vision_triggered_navigator/start_navigation" />
  <arg name="publish_initial_pose" default="true" />
  <arg name="navigate_to_end_after_trigger" default="true" />
  <arg name="coverage_search_mode" default="false" />
  <arg name="coverage_start_nearest" default="false" />
  <arg name="coverage_preferred_anchor" default="0" />
  <arg name="coverage_preferred_odom_yaw_enabled" default="false" />
  <arg name="coverage_preferred_odom_yaw" default="0.0" />
  <arg name="coverage_preferred_confirm_dwell_sec" default="1.2" />
  <arg name="coverage_preferred_scan_half_angle_deg" default="18.0" />
  <arg name="coverage_skip_anchors" default="" />
  <arg name="coverage_goal_retry_count" default="1" />
  <arg name="coverage_goal_soft_timeout_sec" default="7.0" />
  <arg name="coverage_goal_hard_timeout_sec" default="10.0" />
  <arg name="coverage_goal_progress_window_sec" default="5.0" />
  <arg name="coverage_goal_min_progress" default="0.03" />
  <arg name="coverage_anchor_observation_radius" default="0.35" />
  <arg name="coverage_near_anchor_stall_timeout_sec" default="3.0" />
  <arg name="coverage_rotation_min_clearance" default="0.28" />
  <arg name="coverage_translation_min_clearance" default="0.00" />
  <arg name="coverage_translation_sector_half_angle_deg" default="35.0" />
  <arg name="coverage_max_vel_x" default="0.72" />
  <arg name="coverage_max_vel_y" default="0.72" />
  <arg name="coverage_max_vel_theta" default="1.45" />
  <arg name="coverage_cruise_vel_x" default="0.70" />
  <arg name="coverage_cruise_vel_y" default="0.70" />
  <arg name="coverage_cruise_vel_theta" default="1.30" />
  <arg name="coverage_caution_vel_x" default="0.53" />
  <arg name="coverage_caution_vel_y" default="0.53" />
  <arg name="coverage_caution_vel_theta" default="1.12" />
  <arg name="coverage_caution_enter_clearance" default="0.45" />
  <arg name="coverage_caution_exit_clearance" default="0.55" />
  <arg name="coverage_fast_exit_clearance" default="0.75" />
  <arg name="coverage_fast_enter_clearance" default="0.90" />
  <arg name="coverage_speed_update_min_interval_sec" default="0.50" />
  <arg name="target_topic" default="/vision/target" />
  <arg name="non_target_topic" default="/vision/non_target_observation" />
  <arg name="coverage_non_target_early_exit" default="true" />
  <arg name="coverage_non_target_min_scan_steps" default="2" />
  <arg name="target_center_steering_sign" default="-1.0" />
  <arg name="camera_boresight_yaw_offset" default="0.0" />
  <arg name="center_only" default="false" />
  <arg name="max_coverage_anchors" default="0" />
  <arg name="vision_offset" default="0.4" />
  <arg name="coverage_scan_step_deg" default="20.0" />
  <arg name="coverage_scan_angular_speed" default="0.50" />
  <arg name="coverage_scan_dwell_sec" default="0.45" />
  <arg name="coverage_candidate_hold_sec" default="1.2" />
  <arg name="coverage_scan_max_dwell_sec" default="2.0" />
  <arg name="coverage_scan_pose_timeout_sec" default="0.5" />
  <arg name="coverage_scan_step_max_extra_sec" default="3.0" />
  <arg name="coverage_scan_step_retry_count" default="1" />
  <arg name="coverage_scan_step_retry_settle_sec" default="0.20" />
  <arg name="coverage_scan_progress_fresh_sec" default="0.8" />
  <arg name="coverage_scan_progress_epsilon_deg" default="0.5" />
  <arg name="target_center_coarse_step_deg" default="4.0" />
  <arg name="target_center_fine_step_deg" default="2.0" />
  <arg name="target_center_start_speed" default="0.28" />
  <arg name="target_center_step_max_speed" default="0.45" />
  <arg name="target_center_timeout_sec" default="20.0" />
  <arg name="target_center_reacquire_timeout_sec" default="3.0" />
  <arg name="target_center_min_clearance" default="0.23" />
  <arg name="validate_parking_box" default="false" />
  <arg name="parking_box_width" default="0.50" />
  <arg name="parking_box_depth" default="0.50" />
  <arg name="parking_goal_offset" default="0.4" />
  <arg name="parking_staging_offset" default="0.55" />
  <arg name="parking_staging_timeout_sec" default="20.0" />
  <arg name="parking_staging_position_tolerance" default="0.16" />
  <arg name="parking_staging_yaw_tolerance" default="0.10" />
  <arg name="parking_docking_timeout_sec" default="30.0" />
  <arg name="parking_obstacle_min_clearance" default="0.24" />
  <arg name="parking_obstacle_clearance_tolerance" default="0.005" />
  <arg name="parking_obstacle_sector_half_angle_deg" default="35.0" />
  <arg name="parking_dock_max_x" default="0.10" />
  <arg name="parking_dock_max_y" default="0.06" />
  <arg name="parking_dock_max_yaw" default="0.30" />
  <arg name="parking_dock_min_yaw" default="0.30" />
  <arg name="parking_dock_normal_tolerance" default="0.02" />
  <arg name="parking_dock_tangent_tolerance" default="0.02" />
  <arg name="parking_dock_yaw_tolerance" default="0.05" />
  <arg name="parking_min_wall_distance" default="0.19" />
  <arg name="parking_lidar_stop_distance" default="0.15" />
  <arg name="parking_recenter_tolerance" default="0.08" />
  <arg name="parking_recenter_timeout_sec" default="8.0" />
  <arg name="parking_recenter_initial_wait_sec" default="1.0" />
  <arg name="parking_wall_fit_half_angle_deg" default="35.0" />
  <arg name="parking_wall_fit_min_points" default="12" />
  <arg name="parking_wall_fit_min_span" default="0.25" />
  <arg name="parking_wall_fit_near_min_span" default="0.18" />
  <arg name="parking_wall_fit_max_distance_jump" default="0.05" />
  <arg name="parking_wall_fit_max_normal_jump_deg" default="8.0" />
  <arg name="parking_wall_fit_max_residual" default="0.015" />
  <arg name="parking_wall_fit_max_normal_error_deg" default="20.0" />
  <arg name="parking_normal_offset" default="0.0" />
  <arg name="parking_tangent_offset" default="0.0" />
  <arg name="parking_xy_tolerance" default="0.04" />
  <arg name="parking_yaw_tolerance" default="0.06" />

  <!-- 加载参数 -->
  <rosparam file="$(find vision_triggered_navigator)/config/vision_triggered_navigator.yaml" command="load" ns="vision_triggered_navigator" />

  <!-- 启动导航节点 -->
  <node pkg="vision_triggered_navigator" type="vision_triggered_navigator.py" name="vision_triggered_navigator" output="screen">
    <!-- 示例：命令行覆盖触发模式或目标点
         roslaunch vision_triggered_navigator vision_triggered_navigator.launch trigger_mode:=vision
    -->
    <param name="trigger_mode" value="$(arg trigger_mode)" />
    <param name="vision_topic" value="$(arg vision_topic)" />
    <param name="status_topic" value="$(arg status_topic)" />
    <param name="trigger_service" value="$(arg trigger_service)" />
    <param name="start_paused" value="$(arg start_paused)" />
    <param name="start_navigation_service" value="$(arg start_navigation_service)" />
    <param name="publish_initial_pose" value="$(arg publish_initial_pose)" />
    <param name="navigate_to_end_after_trigger" value="$(arg navigate_to_end_after_trigger)" />
    <param name="coverage_search_mode" value="$(arg coverage_search_mode)" />
    <param name="coverage_start_nearest" value="$(arg coverage_start_nearest)" />
    <param name="coverage_preferred_anchor" value="$(arg coverage_preferred_anchor)" />
    <param name="coverage_preferred_odom_yaw_enabled" value="$(arg coverage_preferred_odom_yaw_enabled)" />
    <param name="coverage_preferred_odom_yaw" value="$(arg coverage_preferred_odom_yaw)" />
    <param name="coverage_preferred_confirm_dwell_sec" value="$(arg coverage_preferred_confirm_dwell_sec)" />
    <param name="coverage_preferred_scan_half_angle_deg" value="$(arg coverage_preferred_scan_half_angle_deg)" />
    <param name="coverage_skip_anchors" value="$(arg coverage_skip_anchors)" />
    <param name="coverage_goal_retry_count" value="$(arg coverage_goal_retry_count)" />
    <param name="coverage_goal_soft_timeout_sec" value="$(arg coverage_goal_soft_timeout_sec)" />
    <param name="coverage_goal_hard_timeout_sec" value="$(arg coverage_goal_hard_timeout_sec)" />
    <param name="coverage_goal_progress_window_sec" value="$(arg coverage_goal_progress_window_sec)" />
    <param name="coverage_goal_min_progress" value="$(arg coverage_goal_min_progress)" />
    <param name="coverage_anchor_observation_radius" value="$(arg coverage_anchor_observation_radius)" />
    <param name="coverage_near_anchor_stall_timeout_sec" value="$(arg coverage_near_anchor_stall_timeout_sec)" />
    <param name="coverage_rotation_min_clearance" value="$(arg coverage_rotation_min_clearance)" />
    <param name="coverage_translation_min_clearance" value="$(arg coverage_translation_min_clearance)" />
    <param name="coverage_translation_sector_half_angle_deg" value="$(arg coverage_translation_sector_half_angle_deg)" />
    <param name="coverage_max_vel_x" value="$(arg coverage_max_vel_x)" />
    <param name="coverage_max_vel_y" value="$(arg coverage_max_vel_y)" />
    <param name="coverage_max_vel_theta" value="$(arg coverage_max_vel_theta)" />
    <param name="coverage_cruise_vel_x" value="$(arg coverage_cruise_vel_x)" />
    <param name="coverage_cruise_vel_y" value="$(arg coverage_cruise_vel_y)" />
    <param name="coverage_cruise_vel_theta" value="$(arg coverage_cruise_vel_theta)" />
    <param name="coverage_caution_vel_x" value="$(arg coverage_caution_vel_x)" />
    <param name="coverage_caution_vel_y" value="$(arg coverage_caution_vel_y)" />
    <param name="coverage_caution_vel_theta" value="$(arg coverage_caution_vel_theta)" />
    <param name="coverage_caution_enter_clearance" value="$(arg coverage_caution_enter_clearance)" />
    <param name="coverage_caution_exit_clearance" value="$(arg coverage_caution_exit_clearance)" />
    <param name="coverage_fast_exit_clearance" value="$(arg coverage_fast_exit_clearance)" />
    <param name="coverage_fast_enter_clearance" value="$(arg coverage_fast_enter_clearance)" />
    <param name="coverage_speed_update_min_interval_sec" value="$(arg coverage_speed_update_min_interval_sec)" />
    <param name="target_topic" value="$(arg target_topic)" />
    <param name="non_target_topic" value="$(arg non_target_topic)" />
    <param name="coverage_non_target_early_exit" value="$(arg coverage_non_target_early_exit)" />
    <param name="coverage_non_target_min_scan_steps" value="$(arg coverage_non_target_min_scan_steps)" />
    <param name="target_center_steering_sign" value="$(arg target_center_steering_sign)" />
    <param name="camera_boresight_yaw_offset" value="$(arg camera_boresight_yaw_offset)" />
    <param name="center_only" value="$(arg center_only)" />
    <param name="max_coverage_anchors" value="$(arg max_coverage_anchors)" />
    <param name="vision_offset" value="$(arg vision_offset)" />
    <param name="coverage_scan_step_deg" value="$(arg coverage_scan_step_deg)" />
    <param name="coverage_scan_angular_speed" value="$(arg coverage_scan_angular_speed)" />
    <param name="coverage_scan_dwell_sec" value="$(arg coverage_scan_dwell_sec)" />
    <param name="coverage_candidate_hold_sec" value="$(arg coverage_candidate_hold_sec)" />
    <param name="coverage_scan_max_dwell_sec" value="$(arg coverage_scan_max_dwell_sec)" />
    <param name="coverage_scan_pose_timeout_sec" value="$(arg coverage_scan_pose_timeout_sec)" />
    <param name="coverage_scan_step_max_extra_sec" value="$(arg coverage_scan_step_max_extra_sec)" />
    <param name="coverage_scan_step_retry_count" value="$(arg coverage_scan_step_retry_count)" />
    <param name="coverage_scan_step_retry_settle_sec" value="$(arg coverage_scan_step_retry_settle_sec)" />
    <param name="coverage_scan_progress_fresh_sec" value="$(arg coverage_scan_progress_fresh_sec)" />
    <param name="coverage_scan_progress_epsilon_deg" value="$(arg coverage_scan_progress_epsilon_deg)" />
    <param name="target_center_coarse_step_deg" value="$(arg target_center_coarse_step_deg)" />
    <param name="target_center_fine_step_deg" value="$(arg target_center_fine_step_deg)" />
    <param name="target_center_start_speed" value="$(arg target_center_start_speed)" />
    <param name="target_center_step_max_speed" value="$(arg target_center_step_max_speed)" />
    <param name="target_center_timeout_sec" value="$(arg target_center_timeout_sec)" />
    <param name="target_center_reacquire_timeout_sec" value="$(arg target_center_reacquire_timeout_sec)" />
    <param name="target_center_min_clearance" value="$(arg target_center_min_clearance)" />
    <param name="validate_parking_box" value="$(arg validate_parking_box)" />
    <param name="parking_box_width" value="$(arg parking_box_width)" />
    <param name="parking_box_depth" value="$(arg parking_box_depth)" />
    <param name="parking_goal_offset" value="$(arg parking_goal_offset)" />
    <param name="parking_staging_offset" value="$(arg parking_staging_offset)" />
    <param name="parking_staging_timeout_sec" value="$(arg parking_staging_timeout_sec)" />
    <param name="parking_staging_position_tolerance" value="$(arg parking_staging_position_tolerance)" />
    <param name="parking_staging_yaw_tolerance" value="$(arg parking_staging_yaw_tolerance)" />
    <param name="parking_docking_timeout_sec" value="$(arg parking_docking_timeout_sec)" />
    <param name="parking_obstacle_min_clearance" value="$(arg parking_obstacle_min_clearance)" />
    <param name="parking_obstacle_clearance_tolerance" value="$(arg parking_obstacle_clearance_tolerance)" />
    <param name="parking_obstacle_sector_half_angle_deg" value="$(arg parking_obstacle_sector_half_angle_deg)" />
    <param name="parking_dock_max_x" value="$(arg parking_dock_max_x)" />
    <param name="parking_dock_max_y" value="$(arg parking_dock_max_y)" />
    <param name="parking_dock_max_yaw" value="$(arg parking_dock_max_yaw)" />
    <param name="parking_dock_min_yaw" value="$(arg parking_dock_min_yaw)" />
    <param name="parking_dock_normal_tolerance" value="$(arg parking_dock_normal_tolerance)" />
    <param name="parking_dock_tangent_tolerance" value="$(arg parking_dock_tangent_tolerance)" />
    <param name="parking_dock_yaw_tolerance" value="$(arg parking_dock_yaw_tolerance)" />
    <param name="parking_min_wall_distance" value="$(arg parking_min_wall_distance)" />
    <param name="parking_lidar_stop_distance" value="$(arg parking_lidar_stop_distance)" />
    <param name="parking_recenter_tolerance" value="$(arg parking_recenter_tolerance)" />
    <param name="parking_recenter_timeout_sec" value="$(arg parking_recenter_timeout_sec)" />
    <param name="parking_recenter_initial_wait_sec" value="$(arg parking_recenter_initial_wait_sec)" />
    <param name="parking_wall_fit_half_angle_deg" value="$(arg parking_wall_fit_half_angle_deg)" />
    <param name="parking_wall_fit_min_points" value="$(arg parking_wall_fit_min_points)" />
    <param name="parking_wall_fit_min_span" value="$(arg parking_wall_fit_min_span)" />
    <param name="parking_wall_fit_near_min_span" value="$(arg parking_wall_fit_near_min_span)" />
    <param name="parking_wall_fit_max_distance_jump" value="$(arg parking_wall_fit_max_distance_jump)" />
    <param name="parking_wall_fit_max_normal_jump_deg" value="$(arg parking_wall_fit_max_normal_jump_deg)" />
    <param name="parking_wall_fit_max_residual" value="$(arg parking_wall_fit_max_residual)" />
    <param name="parking_wall_fit_max_normal_error_deg" value="$(arg parking_wall_fit_max_normal_error_deg)" />
    <param name="parking_normal_offset" value="$(arg parking_normal_offset)" />
    <param name="parking_tangent_offset" value="$(arg parking_tangent_offset)" />
    <param name="parking_xy_tolerance" value="$(arg parking_xy_tolerance)" />
    <param name="parking_yaw_tolerance" value="$(arg parking_yaw_tolerance)" />
  </node>

</launch>
