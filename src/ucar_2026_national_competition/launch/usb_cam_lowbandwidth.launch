<launch>
  <!--
    Low-bandwidth USB camera configuration for the Jetson/ARM board.
    Uses MJPEG + 320x240 + 15 fps to avoid xhci "HC couldn't access mem fast
    enough" errors and uvcvideo URB resubmit failures on marginal USB links.
  -->
  <arg name="video_device" default="/dev/video0" />
  <arg name="image_topic" default="/usb_cam/image_raw" />

  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device" value="$(arg video_device)" />
    <param name="image_width" value="320" />
    <param name="image_height" value="240" />
    <param name="pixel_format" value="mjpeg" />
    <param name="framerate" value="15" />
    <param name="camera_frame_id" value="usb_cam" />
    <param name="io_method" value="mmap" />
  </node>

  <node name="image_view" pkg="image_view" type="image_view"
        respawn="false" output="screen">
    <remap from="image" to="$(arg image_topic)" />
    <param name="autosize" value="true" />
  </node>
</launch>
