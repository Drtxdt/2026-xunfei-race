<launch>
  <!-- 国赛总控流程节点 + 坡道节点。
       所有参数来自各包 config/*.yaml，launch 不覆盖任何值；
       调参只改 yaml 后重启 roslaunch。 -->
  <node pkg="ucar_2026_national_competition" type="national_flow_node.py"
        name="national_flow" output="screen" required="true">
    <rosparam command="load"
              file="$(find ucar_2026_national_competition)/config/national_competition.yaml" />
  </node>

  <node pkg="ucar_2026_upanddown" type="ramp_traverse_node.py"
        name="ramp_traverse" output="screen">
    <rosparam command="load"
              file="$(find ucar_2026_upanddown)/config/ramp_traverse.yaml" />
  </node>
</launch>
