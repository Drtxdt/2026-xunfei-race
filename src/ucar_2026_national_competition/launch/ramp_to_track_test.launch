<launch>
  <!--
    Ramp-to-track integration test launch for the national competition.

    Sequence:
      1. Publish /initialpose guess for AMCL.
      2. Navigate to the ramp staging pose.
      3. Run the up-and-down ramp traverse.
      4. Re-publish /initialpose at the calibrated post-ramp pose.
      5. Navigate to the yellow-line stop pose (traffic_x/y/yaw).
      6. Hand over to the provincial task4_task5 flow:
         traffic-light wait at the yellow line, then line following.

    This launch intentionally does NOT start speech/ASR/TTS/LLM/QR/factory-sign
    nodes.  The test node advertises a dummy /competition_speech/announce service
    so provincial task4/task5 announcements do not fail.
  -->
  <arg name="debug" default="false" />
  <arg name="map" default="$(find ucar_nav)/maps/nation.yaml" />
  <arg name="sim_bridge_host" default="$(optenv SIM_BRIDGE_HOST 192.168.1.28)" />

  <!--
    Low-bandwidth camera (MJPEG 320x240@15fps) to avoid xhci bandwidth errors.
    This is started BEFORE common_core so the camera is ready when vision nodes
    start, and it replaces the default usb_cam-test.launch.
  -->
  <include file="$(find ucar_2026_national_competition)/launch/usb_cam_lowbandwidth.launch" />

  <!-- National common core: navigation stack, no camera/speech/llm. -->
  <include file="$(find ucar_2026_national_competition)/launch/national_common_core.launch">
    <arg name="start_nav" value="true" />
    <arg name="start_camera" value="false" />
    <arg name="start_speech" value="false" />
    <arg name="start_asr" value="false" />
    <arg name="start_tts" value="false" />
    <arg name="start_llm" value="false" />
    <arg name="start_rviz" value="$(arg debug)" />
    <arg name="map" value="$(arg map)" />
  </include>

  <!-- Up-and-down ramp traverse node. -->
  <node pkg="ucar_2026_upanddown" type="ramp_traverse_node.py"
        name="ramp_traverse" output="screen">
    <rosparam command="load"
              file="$(find ucar_2026_upanddown)/config/ramp_traverse.yaml" />
  </node>

  <!--
    Test flow node: orchestrates ramp staging -> ramp -> relocalization ->
    yellow-line stop -> provincial task4_task5.  All tunable parameters come
    from config/national_competition.yaml.
  -->
  <node pkg="ucar_2026_national_competition" type="ramp_to_track_test_node.py"
        name="ramp_to_track_test" output="screen" required="true">
    <rosparam command="load"
              file="$(find ucar_2026_national_competition)/config/national_competition.yaml" />
    <param name="skip_ramp" value="false" />
    <param name="sim_bridge_host" value="$(arg sim_bridge_host)" />
  </node>
</launch>
